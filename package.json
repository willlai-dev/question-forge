{
  "name": "question-bank-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "選擇題題庫、作答、對答案與 AI 錯題分析系統",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "bootstrap:env": "node scripts/bootstrap-env.mjs",
    "postinstall": "node scripts/bootstrap-env.mjs --quiet",
    "dev:ports": "node scripts/free-ports.mjs",
    "dev:ports:kill": "node scripts/free-ports.mjs --kill",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "redis:logs": "docker compose logs -f redis",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./packages/*\" --filter \"./apps/*\" dev",
    "dev:api": "pnpm build:packages && pnpm --filter @repo/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @repo/web dev",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "db:test:create": "node scripts/create-test-db.mjs",
    "account:reset": "node scripts/reset-account.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:api-e2e": "node tests/api-e2e/phase1a.mjs && node tests/api-e2e/phase1b.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "pg": "^8.22.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
