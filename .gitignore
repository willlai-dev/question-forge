# ---- 機密設定：絕不可進版控 ----
.env
.env.*
!.env.example
apps/web/.env.local
apps/web/.env*.local

# ---- 相依套件 ----
node_modules/
.pnpm-store/

# ---- 建置產物 ----
dist/
build/
out/
.next/
*.tsbuildinfo

# ---- 測試與覆蓋率 ----
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# ---- 快取 ----
.turbo/
.cache/
.eslintcache
.vitest/

# ---- 編輯器 / 作業系統 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ---- 日誌 ----
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# ---- 本機暫存 ----
tmp/
temp/

# ---- 本機部署腳本 ----
# 這些腳本會寫死本機／內網的位址（例如 Tailscale IP），
# 而本 repo 是公開的——位址一旦進了 git 歷史就拿不掉了。
# 換機器時照著 README 的啟動步驟重寫即可。
restart-prod.ps1
start-prod.ps1
