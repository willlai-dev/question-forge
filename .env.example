# =============================================================================
# 題庫分析系統 — 環境變數範本
#
# 你只需要手動填入「區塊 1」的三個變數，其餘全部由
#   pnpm bootstrap:env
# 自動產生（密鑰以 crypto.randomBytes 隨機產生）並寫入 .env。
#
# 本檔案不得填入任何真實密鑰，且必須進版控；真實的 .env 已列入 .gitignore。
# =============================================================================

# --- 1. 必須由你手動提供（系統不會、也不應自動產生）-------------------------
# NVIDIA NIM API 金鑰，僅存在後端，絕不可暴露到前端。
NVIDIA_API_KEY=
# Tavily 搜尋 API 金鑰，僅存在後端。
TAVILY_API_KEY=
# 本機 PostgreSQL 連線字串，例如：postgresql://user:password@localhost:5432/exercise_analysis
DATABASE_URL=

# --- 2. 自動產生的密鑰（勿手動填寫，勿外流）---------------------------------
# 由 bootstrap-env 以 base64url 隨機產生。
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
CSRF_SECRET=
REDIS_PASSWORD=
# 由 REDIS_PASSWORD / HOST / PORT / DB 推導而成。
REDIS_URL=

# --- 3. 執行環境 -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
API_GLOBAL_PREFIX=api/v1
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- 4. 前端公開變數 ---------------------------------------------------------
# 只有 NEXT_PUBLIC_ 前綴的變數會被寫入 apps/web/.env.local 並進入前端 bundle。
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=題庫分析系統

# --- 5. Redis（由 docker compose up -d redis 啟動）--------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_TEST_DB=1

# --- 6. 認證 -----------------------------------------------------------------
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=localhost

# --- 7. NVIDIA AI ------------------------------------------------------------
# AI_PROVIDER 可設為 nvidia 或 mock；測試與 E2E 使用 mock 以確保決定性且不消耗額度。
AI_PROVIDER=nvidia
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# 免費額度為 40 RPM；此處刻意設為 30，並另外保留 8 RPM 給重試使用。
NVIDIA_MAX_RPM=30
NVIDIA_RETRY_RESERVE_RPM=8
NVIDIA_MAX_CONCURRENT=2
NVIDIA_REQUEST_TIMEOUT_MS=180000
NVIDIA_MAX_RETRIES_429=5
NVIDIA_MAX_RETRIES_5XX=3
NVIDIA_MAX_SCHEMA_REGENERATIONS=2

# --- 8. AI 三階段參數 --------------------------------------------------------
# reasoning_effort 為 NVIDIA 實際支援的參數，合法值：
#   none / minimal / low / medium / high / xhigh / max
# 刻意不使用 none：實測會產生「schema 合法但語意自相矛盾」的輸出。
AI_REASONING_EFFORT_PLAN=low
AI_REASONING_EFFORT_EVIDENCE=medium
AI_REASONING_EFFORT_FINAL=high
AI_REASONING_EFFORT_AGGREGATE=high
AI_MAX_TOKENS_PLAN=1500
AI_MAX_TOKENS_EVIDENCE=3000
AI_MAX_TOKENS_FINAL=8000
AI_MAX_TOKENS_AGGREGATE=8000
AI_TEMPERATURE=0.2

# --- 9. 搜尋（Tavily）-------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_QUERIES_PER_QUESTION=3
TAVILY_MAX_RESULTS_PER_QUERY=5
SEARCH_CACHE_TTL_SECONDS=604800
EXTRACT_CACHE_TTL_SECONDS=2592000
EVIDENCE_SOURCE_MAX_CHARS=4000
EVIDENCE_TOTAL_MAX_CHARS=24000
EVIDENCE_STALE_AFTER_DAYS=90

# --- 10. BullMQ 背景工作 -----------------------------------------------------
# WORKER_INLINE=true 時 worker 與 API 同進程；設為 false 則需另外啟動 worker 進程。
WORKER_INLINE=true
QUEUE_PREFIX=qba
BULLMQ_CONCURRENCY=2
BULLMQ_MAX_ATTEMPTS=3
BULLMQ_BACKOFF_MS=5000
BULLMQ_JOB_TIMEOUT_MS=600000
BULLMQ_REMOVE_ON_COMPLETE=200
BULLMQ_REMOVE_ON_FAIL=500

# --- 11. 上傳與 API 限制 -----------------------------------------------------
IMPORT_MAX_FILE_SIZE_BYTES=10485760
IMPORT_MAX_QUESTIONS=2000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# --- 12. 外部網頁擷取（SSRF 防護上限）---------------------------------------
WEB_FETCH_TIMEOUT_MS=8000
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_REDIRECTS=3
